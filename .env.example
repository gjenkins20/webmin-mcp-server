# Webmin MCP Server Configuration
# Copy this file to .env and fill in your values

# Webmin Connection Settings
WEBMIN_HOST=your-webmin-server.com
WEBMIN_PORT=10000
WEBMIN_USE_HTTPS=true
WEBMIN_VERIFY_SSL=true

# Webmin Credentials
WEBMIN_USERNAME=admin
WEBMIN_PASSWORD=your-password-here

# Connection Timeouts (optional)
WEBMIN_CONNECT_TIMEOUT=10.0
WEBMIN_READ_TIMEOUT=30.0

# MCP Server Settings (optional)
MCP_LOG_LEVEL=INFO
